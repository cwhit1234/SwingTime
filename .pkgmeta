package-as: SwingTime

# Libraries are committed directly in libs/ (not pulled as externals), so the
# CurseForge packager just includes them as-is.

# Files that should not ship inside the packaged addon.
ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - Gallery
  - DESCRIPTION.md

enable-nolib-creation: no
